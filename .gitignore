__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# Test / tooling caches
.pytest_cache/

# Regenerable: connection matrices from precompute_conn.py (~29 MB, ~1 min to rebuild)
results/conn_cache/
# Regenerable: gate zoo + drift snapshot from probe_gatequality.py (deterministic seeds)
results/gatequality_gates/
# Same, for off-default replication cells (--d/--n-facts/--fact-seed). Note the
# stride_*_state.npz in these are resume points costing hours of LP, not minutes
# of training -- every finished run's results live in the JSONs, but a run
# interrupted after a cache wipe restarts from round 0.
results/gatequality_gates_d*_n*_s*/
reference/__pycache__/
